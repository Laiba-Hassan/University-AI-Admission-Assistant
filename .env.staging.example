# Copy to .env.staging (gitignored) and fill in from Supabase Dashboard -> Connect. Never commit real values.
# URL-encode special characters in passwords (@ -> %40, : -> %3A, / -> %2F, # -> %23, ? -> %3F).
# If Node reports a certificate error, add ?sslmode=no-verify to each URL.
#
# app_user: the API. Transaction pooler (port 6543) or direct is fine. Pooler user looks like app_user.<project-ref>
DATABASE_URL=postgresql://app_user.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# app_migrator: migrations. Direct connection or session pooler (port 5432).
DATABASE_URL_MIGRATOR=postgresql://app_migrator.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# app_queue: pg-boss. Direct connection or session pooler (port 5432), NOT the transaction pooler.
DATABASE_URL_QUEUE=postgresql://app_queue.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# postgres: used only by `pnpm db:migrate:staging` for two privileged steps. Direct or session pooler.
DATABASE_URL_ADMIN=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

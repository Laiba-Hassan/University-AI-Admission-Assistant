# Local development defaults (docker-compose). Real environments use secrets from the host, never this file.
DATABASE_URL=postgres://app_user:app_dev@localhost:5433/admission
DATABASE_URL_MIGRATOR=postgres://app_migrator:migrator_dev@localhost:5433/admission
DATABASE_URL_QUEUE=postgres://app_queue:queue_dev@localhost:5433/admission
GEMINI_API_KEY=
# Staff JWT verification (Supabase Auth): set ONE of these.
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
# Meta app secret used to verify X-Hub-Signature-256 on WhatsApp webhooks.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
PORT=3001
# Admin role (postgres) used only by `pnpm db:migrate` for two privileged steps; never used by the running app.
DATABASE_URL_ADMIN=postgres://postgres:postgres@localhost:5433/admission

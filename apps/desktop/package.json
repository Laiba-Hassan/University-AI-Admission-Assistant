{
  "name": "@uaa/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Enrollium desktop app -- a thin wrapper around the live staff dashboard, with a tray icon and desktop notifications for new leads/handoffs.",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder",
    "build:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "ai.enrollium.desktop",
    "productName": "Enrollium",
    "directories": { "buildResources": "build", "output": "release" },
    "files": ["src/**/*"],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "Laiba-Hassan",
      "repo": "University-AI-Admission-Assistant"
    }
  }
}

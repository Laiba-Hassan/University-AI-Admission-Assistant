{
  "name": "university-ai-admission-assistant",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "validate:data": "pnpm --filter @uaa/shared validate:data",
    "db:up": "docker compose up -d",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:test": "node --env-file-if-exists=.env scripts/db-test.mjs",
    "typecheck": "pnpm -r typecheck",
    "api:dev": "pnpm --filter @uaa/api dev",
    "seed": "pnpm --filter @uaa/api seed",
    "recall": "pnpm --filter @uaa/api recall",
    "test": "pnpm --filter @uaa/api test && pnpm --filter @uaa/widget test",
    "db:migrate:staging": "node --env-file=.env.staging scripts/migrate.mjs --staging",
    "db:test:staging": "node --env-file=.env.staging scripts/db-test.mjs --staging",
    "seed:staging": "pnpm --filter @uaa/api seed:staging",
    "widget:dev": "pnpm --filter @uaa/widget dev",
    "widget:build": "pnpm --filter @uaa/widget build",
    "web:dev": "pnpm --filter @uaa/web dev",
    "web:build": "pnpm --filter @uaa/web build"
  },
  "devDependencies": {
    "pg": "^8.23.0"
  }
}
